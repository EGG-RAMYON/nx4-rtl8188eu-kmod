--- a/vehicle/NEMESIS.sh
+++ b/vehicle/NEMESIS.sh
@@ -11,9 +11,15 @@
 mkdir -p "$BASE" || exit 1
 LAUNCH=$USB/NX4_DIAG_LAUNCH.txt
 exec > "$LAUNCH" 2>&1
-printf 'NX4D1 launcher action=%s\n' "$ACTION"
-date; id
-[ "$(id -u)" = 0 ] || { echo 'STOP: root required'; exit 1; }
+echo "NX4D1 launcher action=$ACTION script_revision=2"
+date
+# Android toolbox id may not implement -u. Inspect the exact plain-id UID field.
+ID_TEXT=$(id 2>&1)
+echo "$ID_TEXT"
+case "${ID_TEXT%% *}" in
+    uid=0|uid=0\(*) ;;
+    *) echo 'STOP: root required (plain id did not confirm uid=0)'; exit 1;;
+esac
 SESSION=
 if [ -f "$BASE/current" ]; then
     NAME=$(cat "$BASE/current")
@@ -78,7 +84,7 @@
     cat "$PROC/modules" > "$SESSION/modules_before.txt"
     for F in "$SYS/module/r8188eu/parameters/"*; do
         [ -f "$F" ] || continue
-        printf '%s=' "${F##*/}" >> "$SESSION/original_parameters.txt"
+        echo "PARAMETER ${F##*/}" >> "$SESSION/original_parameters.txt"
         cat "$F" >> "$SESSION/original_parameters.txt"
     done
     dmesg > "$SESSION/dmesg_before_load.txt" 2>&1
--- a/vehicle/worker.sh
+++ b/vehicle/worker.sh
@@ -34,7 +34,7 @@
     [ "$COUNT" -eq 1 ]
 }
 echo $$ > worker.pid
-printf 'WORKER_STARTED\n' > worker_started
+echo WORKER_STARTED > worker_started
 status WAIT_DONGLE
 { id; uname -a; cat "$PROC/self/status"; cat "$PROC/self/attr/current" 2>/dev/null; command -v getenforce >/dev/null && getenforce; } > environment.txt 2>&1
 dmesg > dmesg_armed.txt 2>&1
@@ -50,7 +50,7 @@
     dmesg > dmesg_after.txt 2>&1
     exit 4
 fi
-printf '%s\n' "$IFACE" > interface.txt
+echo "$IFACE" > interface.txt
 status BOUND "$IFACE"
 snapshot > before_up.txt 2>&1
 dmesg > dmesg_before_up.txt 2>&1
